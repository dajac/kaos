{
  "disableAllHooks": false,
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Agent",
      "Skill",
      "TodoWrite",
      "WebSearch",
      "WebFetch",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(./mvnw *)",
      "Bash(./run.sh *)",
      "Bash(./factory *)",
      "Bash(scripts/factory/*)",
      "Bash(*/scripts/factory/*)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(java *)",
      "Bash(jar *)",
      "Bash(javap *)",
      "Bash(docker *)",
      "Bash(curl *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(xargs *)",
      "Bash(tee *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm *)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(test *)",
      "Bash(sleep *)",
      "Bash(date *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(lsof *)",
      "Bash(ps *)",
      "Bash(pwd)",
      "Bash(cd *)",
      "Bash(bash -n *)",
      "Bash(open -g *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh issue close *)",
      "Bash(gh auth *)",
      "Bash(gh pr review * --approve*)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git push * refs/heads/main)",
      "Bash(./factory merge *)",
      "Bash(ssh *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$FACTORY_HOME\"/.claude/hooks/session-identity.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$FACTORY_HOME\"/.claude/hooks/factory-guard.sh"
          }
        ]
      }
    ]
  }
}
