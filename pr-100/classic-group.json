{
  "description": "One topic of 6 partitions fed at 2 records/s per partition, and a classic group of 3 consumers, stable with every partition assigned.",
  "steps": [
    {
      "request": "POST /api/v1/simulator",
      "body": {
        "topics": [
          {
            "name": "orders",
            "partitions": 6
          }
        ],
        "producers": [
          {
            "topics": [
              "orders"
            ],
            "ratePerPartition": 2
          }
        ],
        "groups": [
          {
            "id": "orders-app",
            "subscribedTopics": [
              "orders"
            ],
            "consumerDefaults": {
              "protocol": "classic"
            },
            "consumers": [
              {},
              {},
              {}
            ]
          }
        ]
      }
    },
    {
      "wait": {
        "path": "/api/v1/simulator",
        "jq": ".phase == \"RUNNING\"",
        "timeout_s": 90
      }
    },
    {
      "wait": {
        "path": "/api/v1/simulator/snapshot",
        "jq": "[.groups[] | select(.id == \"orders-app\")][0] as $g | $g.type == \"CLASSIC\" and $g.state == \"STABLE\" and ($g.consumers | length) == 3 and all($g.consumers[]; (.raw.assignment | length) > 0) and ([$g.consumers[].raw.assignment[]] | length) == 6",
        "timeout_s": 90
      }
    }
  ]
}
