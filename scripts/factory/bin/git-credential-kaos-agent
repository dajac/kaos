#!/usr/bin/env bash
# git credential helper that answers with the bot's installation token
# for github.com, and with nothing for any other host.
set -euo pipefail
[[ ${1:-} == get ]] || exit 0
host=
while IFS='=' read -r key value; do
    [[ -z $key ]] && break
    [[ $key == host ]] && host=$value
done
[[ $host == github.com ]] || exit 0
echo username=x-access-token
echo "password=$("$(cd "$(dirname "$0")" && pwd)/../token.sh")"
