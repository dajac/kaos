{
  "description": "One topic of 6 partitions fed at 2 records/s per partition, and a group of 3 consumers to which the coordinator assigned every partition.",
  "steps": [
    {
      "request": "POST /api/v1/simulator",
      "body": {
        "topics": [
          {
            "name": "orders",
            "partitions": 6
          }
        ],
        "producers": [
          {
            "topics": [
              "orders"
            ],
            "ratePerPartition": 2
          }
        ],
        "groups": [
          {
            "id": "orders-app",
            "subscribedTopics": [
              "orders"
            ],
            "consumers": [
              {},
              {},
              {}
            ]
          }
        ]
      }
    },
    {
      "wait": {
        "path": "/api/v1/simulator",
        "jq": ".phase == \"RUNNING\"",
        "timeout_s": 90
      }
    },
    {
      "wait": {
        "path": "/api/v1/simulator/snapshot",
        "jq": "[.groups[] | select(.id == \"orders-app\") | .consumers[].raw.assignment[]] | length == 6",
        "timeout_s": 90
      }
    }
  ]
}
